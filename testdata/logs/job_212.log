                'bufs': bufs,
                'greedy': greedy_layout,
                'optimal': opt_layout,
                'num_ops': num_ops
            }
            
        print(f"[{m_key.upper()} - {q_prof.upper()}] Greedy: {greedy_peak} B | Optimal: {opt_peak} B | LowerBound: {lower_bound} B | Algo Gap: {algo_frag_gap_pct:.2f}% | Total TFLM vs MicroFlow RAM Penalty: {total_ram_penalty_pct:.2f}%")

df = pd.DataFrame(results)
